{
  "manifest_version": 3,
  "name": "快捷AI",
  "version": "1.2.0",
  "description": "选中网页文字，使用快捷AI提示词获取 AI 回复。",
  "permissions": [
    "activeTab",
    "contextMenus",
    "scripting",
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "quick-ai@quick-ai.invalid",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "authenticationInfo",
          "websiteContent"
        ]
      }
    }
  },
  "options_page": "options.html",
  "action": {
    "default_title": "快捷AI"
  }
}
